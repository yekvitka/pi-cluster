#cloud-config

# Set TimeZone and Locale
timezone: UTC
locale: en_US.UTF-8

# Hostname
hostname: nodeX

# cloud-init not managing hosts file. only hostname is added
manage_etc_hosts: localhost

# No default ubuntu user: login as root with SSH key only
disable_root: false
ssh_pwauth: false
users:
  - name: root
    lock_passwd: true
    ssh_authorized_keys:
      # Replaced by `make prepare-nodeX` with the key in metal/rpi/cloud-init/root.pub
      - SSH_PUB_KEY

write_files:
  # The home router also hands out its IPv6 DNS servers over DHCPv6 (see network-config)
  - path: /etc/systemd/network/10-netplan-eth0.network.d/no-dhcp6-dns.conf
    content: |
      [DHCPv6]
      UseDNS=false
      UseDomains=false
  - path: /etc/systemd/network/10-netplan-wlan0.network.d/no-dhcp6-dns.conf
    content: |
      [DHCPv6]
      UseDNS=false
      UseDomains=false
  # Network is configured once, at first boot: do not rewrite netplan afterwards
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    content: |
      network: {config: disabled}

runcmd:
  # Load the DHCPv6 drop-in, networkd is already running at this point
  - [networkctl, reconfigure, eth0, wlan0]
  # Longhorn data path (defaultDataPath). Without centralized SAN it is a
  # directory on the node's own disk
  - [mkdir, -p, /storage]

#cloud-config

# Set TimeZone and Locale
timezone: UTC
locale: en_US.UTF-8

# Hostname
hostname: nodeX

# cloud-init not managing hosts file. only hostname is added
manage_etc_hosts: localhost

# No default ubuntu user. Ansible logs in as ansible (passwordless sudo, SSH
# key only); root has no SSH keys, and sshd refuses it (ricsanfre.security)
disable_root: true
ssh_pwauth: false
users:
  - name: ansible
    lock_passwd: true
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    # Replaced by `make prepare-nodeX` with every key in metal/rpi/cloud-init/ansible.pub
    ssh_authorized_keys: SSH_PUB_KEYS

write_files:
  # The home router also hands out its IPv6 DNS servers over DHCPv6 (see network-config)
  - path: /etc/systemd/network/10-netplan-eth0.network.d/no-dhcp6-dns.conf
    content: |
      [DHCPv6]
      UseDNS=false
      UseDomains=false
  - path: /etc/systemd/network/10-netplan-wlan0.network.d/no-dhcp6-dns.conf
    content: |
      [DHCPv6]
      UseDNS=false
      UseDomains=false
  # Network is configured once, at first boot: do not rewrite netplan afterwards
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    content: |
      network: {config: disabled}

runcmd:
  # Load the DHCPv6 drop-in, networkd is already running at this point
  - [networkctl, reconfigure, eth0, wlan0]
  # Longhorn data path (defaultDataPath): a directory on the node's own disk
  - [mkdir, -p, /storage]

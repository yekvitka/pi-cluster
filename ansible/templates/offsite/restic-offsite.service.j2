# Managed by ansible/offsite_backup.yml
[Unit]
Description=Offsite restic copy of the RustFS backups (Oracle Cloud VM)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/offsite.env
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/bin/restic backup --tag rustfs {{ offsite_backup_sources | join(' ') }}
ExecStartPost=/usr/local/bin/restic forget --tag rustfs --prune {{ offsite_restic_retention }}

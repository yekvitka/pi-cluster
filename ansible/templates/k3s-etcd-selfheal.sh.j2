#!/bin/bash
# k3s-etcd-selfheal: ExecStartPre of k3s on the etcd servers.
# Managed by Ansible (ansible/tasks/power_loss.yml).
#
# A hard power cut can corrupt the local etcd database (2026-11-08, node3): k3s
# then panics in bbolt on every start, before etcd is ready. After two such
# starts in a row, this script asks the cluster to remove this member (node
# annotation; k3s's member removal controller runs on the API server), moves the
# database aside and lets k3s rejoin as a new member. Losing this member's data is
# fine: the other members have it.
#
# Needs the API ({{ api_url }}) and the other members up. Never runs on its own
# database twice in one boot. node6, the only API server, cannot heal itself this
# way: docs/runbooks/node-ssd-migration.md "Corrupted etcd member".
#
# Test without changes: DRYRUN=1 /usr/local/sbin/k3s-etcd-selfheal
set -u

NODE="$(hostname)"
DB=/var/lib/rancher/k3s/server/db
DONE=/run/k3s-etcd-selfheal.done
KC="k3s kubectl --kubeconfig /etc/rancher/k3s/k3s.yaml --server {{ api_url }} --request-timeout=15s"
ANN=etcd.k3s.cattle.io

log() { echo "k3s-etcd-selfheal: $*"; }

[ -d "$DB/etcd/member" ] || exit 0
[ -e "$DONE" ] && exit 0

# Starts since etcd was last ready that panicked in bbolt before etcd got ready
failed=$(journalctl -b -u k3s.service --no-pager -o cat 2>/dev/null | awk '
  /Starting k3s v/ { ready = 0; counted = 0 }
  /ready to serve client requests/ { if (!ready) { ready = 1; n = 0 } }
  /^panic: (freepages|assertion failed|page [0-9]+ |invalid page|unexpected page)/ { if (!ready && !counted) { n++; counted = 1 } }
  END { print n + 0 }')

if [ "${DRYRUN:-0}" = 1 ]; then
  log "dry run: $failed start(s) panicked opening the etcd database since etcd was last ready (heals at 2)"
  exit 0
fi
[ "$failed" -ge 2 ] || exit 0

log "$failed starts panicked opening the etcd database: resetting this member"
if ! member=$($KC get node "$NODE" -o jsonpath="{.metadata.annotations.etcd\.k3s\.cattle\.io/node-name}" 2>&1); then
  log "API not reachable ($member): k3s retries"
  exit 0
fi
if [ -z "$member" ]; then
  log "node $NODE has no etcd member name: nothing to remove"
  exit 0
fi

# A removed-node-name left by an earlier heal would make k3s skip this request
$KC annotate node "$NODE" "$ANN/removed-node-name-" >/dev/null 2>&1
$KC annotate node "$NODE" "$ANN/remove=true" --overwrite >/dev/null || exit 0
removed=""
for _ in $(seq 1 24); do
  removed=$($KC get node "$NODE" -o jsonpath="{.metadata.annotations.etcd\.k3s\.cattle\.io/removed-node-name}" 2>/dev/null)
  [ "$removed" = "$member" ] && break
  sleep 5
done
if [ "$removed" != "$member" ]; then
  log "member $member was not removed (API or quorum): k3s retries"
  exit 0
fi

rm -rf "$DB".corrupt-*
mv "$DB" "$DB.corrupt-$(date +%Y%m%d-%H%M%S)"
touch "$DONE"
log "member $member removed, database moved aside: k3s joins as a new member"
exit 0

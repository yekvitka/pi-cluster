.venv
/certs

# Terraform: providers, local state, plans and variable files stay on the control
# host; the provider lock files are in Git
/terraform/*/.terraform
/terraform/*/terraform.tfstate
/terraform/*/terraform.tfstate.backup
/terraform/*/terraform.tfvars
/terraform/*/tfplan

# Metal: downloaded images, gateway config, per-machine SSH key for cloud-init
/metal/openwrt/config
/metal/openwrt/img
/metal/rpi/cloud-init/ansible.pub


{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':skipStatusChecks',
    'github>yekvitka/pi-cluster//.github/renovate/clusters.json5',
    'github>yekvitka/pi-cluster//.github/renovate/customManagers.json5',
    'github>yekvitka/pi-cluster//.github/renovate/grafanaDashboards.json5',
    'github>yekvitka/pi-cluster//.github/renovate/groups.json5',
    'github>yekvitka/pi-cluster//.github/renovate/labels.json5',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  ansible: {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'ansible-galaxy': {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      // Stay on k3s 1.36.x: patch releases only, minor upgrades are done by hand
      description: 'Hold k3s below 1.37',
      matchPackageNames: ['k3s-io/k3s'],
      allowedVersions: '<1.37.0',
    },
  ],
}

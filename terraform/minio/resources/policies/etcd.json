{
  "name": "etcd",
  "description": "k3s etcd snapshots access policy",
  "statements": [
    {
      "effect": "Allow",
      "actions": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "resources": [
        "arn:aws:s3:::k3s-etcd"
      ]
    },
    {
      "effect": "Allow",
      "actions": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "resources": [
        "arn:aws:s3:::k3s-etcd/*"
      ]
    }
  ]
}

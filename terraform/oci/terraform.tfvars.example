# Copy to terraform.tfvars (gitignored). Values from the OCI console:
# Profile > My profile > API keys > Configuration file preview
tenancy_ocid     = "ocid1.tenancy.oc1..<id>"
user_ocid        = "ocid1.user.oc1..<id>"
fingerprint      = "<aa:bb:...>"
private_key_path = "/home/runner/.secrets/oci/oci_api_key.pem" # path inside the ansible runner
region           = "<home region, e.g. eu-frankfurt-1>"
